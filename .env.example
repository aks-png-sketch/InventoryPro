DB_HOST=localhost
DB_PORT=1521
DB_SERVICE=XEPDB1
DB_USERNAME=INVENTORY_APP
DB_PASSWORD=
SPRING_PROFILES_ACTIVE=dev
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=
SESSION_COOKIE_SECURE=true
# For local HTTP only, Start-Backend.ps1 sets this to false.
# Optional full URL override, especially for provider-supplied TLS descriptors:
# DB_URL=jdbc:oracle:thin:@//remote-host:1521/remote-service
# PORT=8080
# FORWARD_HEADERS_STRATEGY=framework
# FRONTEND_ORIGINS=https://inventory.example
# VITE_API_BASE_URL belongs in frontend/.env or the frontend build environment.
